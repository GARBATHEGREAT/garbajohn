<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0a0d12">
  <meta name="description" content="Professional CV of Garba John, a software engineer in Abuja with AI model evaluation, Python, full-stack and Android experience.">
  <meta name="robots" content="index,follow">
  <link rel="canonical" href="https://garbajohn.vercel.app/cv">
  <title>Garba John | Software Engineer CV</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #11130f;
      --paper: #f4f2ea;
      --acid: #bdff42;
      --muted: #62665f;
      --line: #cbc9bf;
      --night: #0a0d12;
      --night-line: #29313c;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 112px; }
    body { background: var(--night); color: var(--ink); font-family: Manrope, Arial, sans-serif; margin: 0; }
    a { color: inherit; }
    a:focus-visible, button:focus-visible { outline: 3px solid var(--acid); outline-offset: 3px; }

    .cv-top {
      backdrop-filter: blur(18px);
      background: rgba(10, 13, 18, .92);
      border-bottom: 1px solid var(--night-line);
      color: #f3f7ef;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .cv-bar {
      align-items: center;
      display: grid;
      gap: 22px;
      grid-template-columns: auto 1fr auto;
      margin: auto;
      min-height: 76px;
      width: min(1180px, calc(100% - 30px));
    }

    .back-link {
      font-size: 13px;
      font-weight: 800;
      text-decoration: none;
    }

    .cv-nav {
      display: flex;
      gap: 18px;
      justify-content: center;
    }

    .cv-nav a {
      color: #8994a3;
      font: 500 9px DM Mono, monospace;
      letter-spacing: .1em;
      text-decoration: none;
    }

    .cv-nav a:hover { color: var(--acid); }

    .cv-actions { display: flex; gap: 8px; }
    .cv-action {
      background: transparent;
      border: 1px solid #424c59;
      border-radius: 999px;
      color: #fff;
      cursor: pointer;
      font: 700 11px Manrope, sans-serif;
      padding: 11px 15px;
      text-decoration: none;
    }

    .cv-action.primary { background: var(--acid); border-color: var(--acid); color: #111; }
    .cv-action.is-copied { border-color: var(--acid); color: var(--acid); }

    .cv-wrap { margin: 44px auto; width: min(1060px, calc(100% - 28px)); }
    .cv-paper { background: var(--paper); box-shadow: 0 35px 100px rgba(0, 0, 0, .36); overflow: hidden; }

    .cv-hero {
      border-bottom: 2px solid var(--ink);
      display: grid;
      gap: 48px;
      grid-template-columns: 1.3fr .7fr;
      padding: 58px 62px 38px;
    }

    .cv-kicker {
      background: var(--acid);
      border-radius: 99px;
      display: inline-block;
      font: 500 10px DM Mono, monospace;
      letter-spacing: .08em;
      padding: 4px 8px;
    }

    h1 {
      font-size: clamp(50px, 8vw, 78px);
      letter-spacing: -.07em;
      line-height: .84;
      margin: 14px 0 18px;
    }

    .cv-role {
      font: 500 12px/1.7 DM Mono, monospace;
      letter-spacing: .11em;
      max-width: 630px;
    }

    .cv-contact {
      align-content: end;
      color: var(--muted);
      display: grid;
      font-size: 12px;
      font-style: normal;
      gap: 7px;
      justify-items: end;
      text-align: right;
    }

    .cv-contact a { text-underline-offset: 3px; }

    .cv-identity {
      align-items: end;
      display: flex;
      gap: 18px;
      justify-content: end;
    }

    .cv-photo {
      border: 1px solid var(--ink);
      height: 136px;
      object-fit: cover;
      object-position: center 23%;
      width: 104px;
    }

    .proof-strip {
      border-bottom: 1px solid var(--line);
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .proof-strip > div {
      border-right: 1px solid var(--line);
      display: grid;
      gap: 2px;
      min-height: 112px;
      padding: 22px 26px;
    }

    .proof-strip > div:last-child { border-right: 0; }
    .proof-strip span { color: var(--muted); font: 500 9px DM Mono, monospace; letter-spacing: .12em; }
    .proof-strip strong { align-self: end; font-size: 23px; letter-spacing: -.04em; }

    .cv-section {
      border-bottom: 1px solid var(--line);
      display: grid;
      gap: 38px;
      grid-template-columns: 180px 1fr;
      padding: 36px 62px;
    }

    .cv-section:last-child { border-bottom: 0; }
    .section-label { color: var(--muted); font: 500 10px DM Mono, monospace; letter-spacing: .12em; padding-top: 4px; }
    .section-body > p { font-size: 14px; line-height: 1.75; margin: 0; }

    .experience-item + .experience-item,
    .project-item + .project-item,
    .education-item + .education-item {
      border-top: 1px solid var(--line);
      margin-top: 24px;
      padding-top: 24px;
    }

    .item-heading {
      align-items: start;
      display: flex;
      gap: 18px;
      justify-content: space-between;
    }

    .item-heading h2 { font-size: 21px; letter-spacing: -.035em; margin: 0 0 5px; }
    .item-meta { color: var(--muted); font-size: 12px; font-weight: 700; line-height: 1.5; }
    .item-date { color: var(--muted); flex: 0 0 auto; font: 500 10px DM Mono, monospace; letter-spacing: .08em; padding-top: 5px; }
    ul { margin: 13px 0 0; padding-left: 19px; }
    li { font-size: 13px; line-height: 1.67; margin: 5px 0; }

    .project-heading {
      align-items: center;
      display: flex;
      gap: 10px;
      justify-content: space-between;
    }

    .project-heading h2 { font-size: 20px; letter-spacing: -.03em; margin: 0; }
    .project-status {
      align-items: center;
      border: 1px solid #aaa99f;
      border-radius: 99px;
      display: inline-flex;
      font: 500 8px DM Mono, monospace;
      gap: 6px;
      letter-spacing: .08em;
      padding: 6px 9px;
    }

    .project-status::before { background: #319a58; border-radius: 50%; content: ""; height: 6px; width: 6px; }
    .project-status.source::before { background: #147d94; }
    .project-stack { color: var(--muted); font: 500 10px/1.6 DM Mono, monospace; margin: 6px 0 9px; }
    .project-item p { font-size: 13px; line-height: 1.68; margin: 0; }
    .project-links { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 9px; }
    .project-links a { font-size: 11px; font-weight: 800; text-underline-offset: 3px; }

    .skills-grid { display: grid; gap: 22px 34px; grid-template-columns: 1fr 1fr; }
    .skill-block b { display: block; font-size: 12px; margin-bottom: 5px; }
    .skill-block span { color: var(--muted); font-size: 12px; line-height: 1.6; }

    .education-item h2 { font-size: 19px; letter-spacing: -.03em; margin: 0 0 4px; }
    .education-item p { color: var(--muted); font-size: 12px; margin: 5px 0 0; }

    .cv-note { color: #949caa; font: 500 10px DM Mono, monospace; margin: 0 auto 36px; text-align: center; }

    @media (max-width: 850px) {
      .cv-bar { grid-template-columns: 1fr auto; }
      .cv-nav { display: none; }
      .cv-hero { grid-template-columns: 1fr; gap: 26px; padding: 42px 34px 30px; }
      .cv-identity { justify-content: start; }
      .cv-contact { justify-items: start; text-align: left; }
      .cv-section { gap: 16px; grid-template-columns: 1fr; padding: 31px 34px; }
      .proof-strip { grid-template-columns: 1fr; }
      .proof-strip > div { border-bottom: 1px solid var(--line); border-right: 0; min-height: 88px; }
      .proof-strip > div:last-child { border-bottom: 0; }
    }

    @media (max-width: 600px) {
      .cv-wrap { margin: 18px auto; }
      .cv-actions .copy-email { display: none; }
      .cv-action { font-size: 10px; padding: 10px 12px; }
      .cv-hero { padding: 34px 22px 28px; }
      .cv-photo { height: 108px; width: 82px; }
      .cv-section { padding: 28px 22px; }
      .skills-grid { grid-template-columns: 1fr; }
      .item-heading { display: grid; gap: 5px; }
      .item-date { padding-top: 0; }
      h1 { font-size: 50px; }
    }

    @media print {
      @page { margin: 10mm; }
      body { background: #fff; }
      .cv-top, .cv-note { display: none; }
      .cv-wrap { margin: 0; width: 100%; }
      .cv-paper { box-shadow: none; }
      .cv-hero { padding: 0 0 22px; }
      .proof-strip > div { min-height: 80px; padding: 15px 18px; }
      .cv-section { gap: 25px; grid-template-columns: 145px 1fr; padding: 22px 0; }
      .experience-item, .project-item, .education-item, .skill-block { break-inside: avoid; }
      h1 { font-size: 50px; }
      .section-body > p, li, .project-item p { font-size: 11px; }
      .project-links a { text-decoration: none; }
    }
  </style>
</head>
